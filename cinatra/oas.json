{
  "agentspec_version": "26.1.0",
  "component_type": "Flow",
  "id": "skill-recommender-flow",
  "name": "Skill Recommender Agent",
  "description": "Reviews the skills that will be applied to the drafting step and lets the user confirm before drafts are generated.",
  "metadata": {
    "cinatra": {
      "type": "flow",
      "packageName": "@cinatra-ai/skill-recommender-agent",
      "hitlScreens": [
        "@cinatra-ai/skill-recommender-agent:recommend"
      ]
    }
  },
  "inputs": [
    {
      "title": "cinatra_run_id",
      "type": "string",
      "default": ""
    }
  ],
  "outputs": [
    {
      "title": "confirmed",
      "type": "string"
    }
  ],
  "start_node": {
    "$component_ref": "start"
  },
  "nodes": [
    {
      "$component_ref": "start"
    },
    {
      "$component_ref": "prep_skills"
    },
    {
      "$component_ref": "recommend_gate"
    },
    {
      "$component_ref": "end"
    }
  ],
  "control_flow_connections": [
    {
      "component_type": "ControlFlowEdge",
      "name": "start_to_prep_skills",
      "from_node": {
        "$component_ref": "start"
      },
      "to_node": {
        "$component_ref": "prep_skills"
      }
    },
    {
      "component_type": "ControlFlowEdge",
      "name": "prep_skills_to_recommend_gate",
      "from_node": {
        "$component_ref": "prep_skills"
      },
      "to_node": {
        "$component_ref": "recommend_gate"
      }
    },
    {
      "component_type": "ControlFlowEdge",
      "name": "recommend_gate_to_end",
      "from_node": {
        "$component_ref": "recommend_gate"
      },
      "to_node": {
        "$component_ref": "end"
      }
    }
  ],
  "data_flow_connections": [
    {
      "component_type": "DataFlowEdge",
      "name": "start_cinatra_run_id_to_prep_skills_agent_run_id",
      "source_node": {
        "$component_ref": "start"
      },
      "source_output": "cinatra_run_id",
      "destination_node": {
        "$component_ref": "prep_skills"
      },
      "destination_input": "agent_run_id"
    },
    {
      "component_type": "DataFlowEdge",
      "name": "prep_skills_skillIds_to_recommend_gate_skillIds",
      "source_node": {
        "$component_ref": "prep_skills"
      },
      "source_output": "skillIds",
      "destination_node": {
        "$component_ref": "recommend_gate"
      },
      "destination_input": "skillIds"
    },
    {
      "component_type": "DataFlowEdge",
      "name": "recommend_gate_to_end_confirmed",
      "source_node": {
        "$component_ref": "recommend_gate"
      },
      "source_output": "confirmed",
      "destination_node": {
        "$component_ref": "end"
      },
      "destination_input": "confirmed"
    }
  ],
  "$referenced_components": {
    "start": {
      "component_type": "StartNode",
      "id": "start",
      "name": "Inputs",
      "metadata": {
        "cinatra": {
          "required": [],
          "hidden": [
            "cinatra_run_id"
          ]
        }
      },
      "inputs": [
        {
          "title": "cinatra_run_id",
          "type": "string",
          "default": ""
        }
      ]
    },
    "prep_skills": {
      "component_type": "ApiNode",
      "id": "prep_skills",
      "name": "Resolve drafting skills",
      "url": "{{CINATRA_BASE_URL}}/api/agents/passthrough",
      "http_method": "POST",
      "data": {
        "tool": "skills_installed_resolve_for_agent",
        "input": {
          "agentId": "@cinatra-ai/email-drafting-agent"
        },
        "agent_run_id": "{{ agent_run_id }}"
      },
      "inputs": [
        {
          "title": "agent_run_id",
          "type": "string",
          "default": ""
        }
      ],
      "outputs": [
        {
          "title": "skillIds",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "string"
            }
          },
          "default": []
        }
      ],
      "metadata": {
        "cinatra": {
          "riskClass": "read_only",
          "requiresApproval": false,
          "packageName": "@cinatra-ai/skill-recommender-agent",
          "description": "Deterministic pre-interrupt data prep (cinatra#1625, enablement #1794). Resolves the skill ids assigned to the drafting agent through the /api/agents/passthrough seam (skills_installed_resolve_for_agent), binding the run + actor route-side from the executing run — never trusting caller input. The resolved skillIds ride a DataFlowEdge into the review gate so the renderer displays an authorized snapshot instead of calling an authenticated host action. The target drafting package is extension-owned workflow config."
        }
      }
    },
    "recommend_gate": {
      "component_type": "InputMessageNode",
      "id": "recommend_gate",
      "name": "Review skills",
      "metadata": {
        "cinatra": {
          "riskClass": "read_only",
          "requiresApproval": true,
          "renderer": "@cinatra-ai/skill-recommender-agent:recommend",
          "a2uiSurfaceId": "skill-recommender:recommend-gate:input",
          "autoSkipWhenInputsPresent": false,
          "description": "Review the skills that will guide the email drafting step.",
          "inputMessageSchema": {
            "type": "object",
            "x-renderer": "@cinatra-ai/skill-recommender-agent:recommend",
            "properties": {
              "confirmed": {
                "type": "boolean",
                "title": "Confirmed"
              }
            },
            "required": [
              "confirmed"
            ]
          }
        }
      },
      "inputs": [
        {
          "title": "skillIds",
          "type": "array",
          "json_schema": {
            "items": {
              "type": "string"
            }
          },
          "default": []
        }
      ],
      "outputs": [
        {
          "title": "confirmed",
          "type": "string"
        }
      ]
    },
    "end": {
      "component_type": "EndNode",
      "id": "end",
      "name": "End",
      "outputs": [
        {
          "title": "confirmed",
          "type": "string"
        }
      ]
    }
  }
}
